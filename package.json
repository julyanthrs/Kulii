{
  "name": "kulii",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "start": "tsx server/index.ts",
    "db:reset": "tsx server/reset.ts",
    "db:remove-demo": "tsx server/remove-demo.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "immer": "^10.2.0",
    "lucide-react": "^0.445.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
