# Copy this file to .env and fill in the values from your Supabase project.
# .env is git-ignored — never commit real keys.

# --- Safe for the browser (public) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# "Publishable key" (sb_publishable_...) or legacy "anon" key (eyJ...)
VITE_SUPABASE_ANON_KEY=

# --- Server only (SECRET — full access to your data) ---
# Same Project URL as above
SUPABASE_URL=
# "Secret key" (sb_secret_...) or legacy "service_role" key (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=
# Connection string (Connect → Connection String → Session pooler). Paste it exactly as shown — keep [YOUR-PASSWORD].
DATABASE_URL=
# Your database password (the one you set when creating the project)
DATABASE_PASSWORD=
